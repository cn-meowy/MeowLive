{
  "name": "simple-live-server",
  "version": "1.0.0",
  "description": "聚合直播后台服务，基于 Node.js + TypeScript 重写",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsc",
    "start": "tsx --experimental-sqlite src/index.ts",
    "dev": "tsx watch --experimental-sqlite src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-sqlite --test --import tsx test/*.test.ts",
    "plugins:list": "tsx scripts/plugins-list.ts"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.1",
    "@fastify/static": "^8.1.0",
    "@fastify/websocket": "^11.0.2",
    "@types/qrcode": "^1.5.6",
    "axios": "^1.7.9",
    "fastify": "^5.2.1",
    "html-entities": "^2.6.0",
    "pino": "^9.5.0",
    "protobufjs": "^7.4.0",
    "qrcode": "^1.5.4",
    "quickjs-emscripten": "^0.32.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "@types/ws": "^8.5.13",
    "eslint": "^9.18.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.21.0"
  }
}
