{
  "pluginId": "bilibili",
  "version": "2.0.0",
  "apiVersion": 1,
  "displayName": "哔哩哔哩",
  "platformDescription": "哔哩哔哩直播平台",
  "liveTypes": [
    "0"
  ],
  "entry": "index.js",
  "preloadScripts": [
    "fflate_0.8.2_umd.js",
    "lp_plugin_bilibili_1.0.11_login.js",
    "lp_plugin_bilibili_1.0.11_danmaku.js"
  ],
  "auth": {
    "required": true,
    "credentialKinds": [
      "cookie"
    ],
    "supportsStatusCheck": true,
    "supportsValidation": true
  },
  "loginFlow": {
    "kind": "webview",
    "loginURL": "https://passport.bilibili.com/h5-app/passport/login?gourl=https%3A%2F%2Flive.bilibili.com%2Fp%2Feden%2Farea-tags%3FparentAreaId%3D2%26areaId%3D86",
    "cookieDomains": [
      "bilibili.com"
    ],
    "authSignalCookies": [
      "SESSDATA"
    ],
    "uidCookieNames": [
      "DedeUserID"
    ],
    "successURLKeyword": "live.bilibili.com/p/eden/area-tags",
    "successTitleKeyword": "直播",
    "postRedirectDelay": 0,
    "requiredCookieHint": "需包含 SESSDATA、bili_jct、DedeUserID",
    "websiteHost": "bilibili.com"
  },
  "capabilities": {
    "categories": {
      "status": "available"
    },
    "rooms": {
      "status": "available"
    },
    "playback": {
      "status": "available"
    },
    "search": {
      "status": "available"
    },
    "roomDetail": {
      "status": "available"
    },
    "liveState": {
      "status": "available"
    },
    "shareResolve": {
      "status": "available"
    },
    "danmaku": {
      "status": "available",
      "driver": "plugin_js_v1",
      "transport": "websocket",
      "protocolId": "bilibili_ws",
      "protocolVersion": "1"
    }
  },
  "changelog": [
    "manifest 规范化：platformDescription 仅描述平台定位，登录需求改由 auth.required 与 credentialKinds 明确声明",
    "原 platformDescription 说明已迁移到 changelog：列表返回352、超清直播须在设置扫码",
    "登录需求明确为必需：需要宿主提供平台 cookie 登录态后使用",
    "manifest 补齐 loginFlow（webview）声明：loginURL、cookieDomains、authSignalCookies 等，宿主平台账号登录页即可识别并渲染登录入口",
    "登录插件化对齐 xhs：login.js 不再存 cookie 副本，_bili_loginRequest 改为 pass-through（不再 merge cookie+降级 authMode），业务请求全程走 platform_cookie 由宿主注入",
    "弹幕解压增加纯 JS fflate 回退，宿主未提供 zlib helper 时仍可解析 B 站压缩包",
    "弹幕鉴权 uid 改为优先使用登录态 mid，与 Swift 旧版 BiliBiliCookie.uid 行为对齐，缺失时回退 0",
    "增加弹幕建连调试日志，打印 host_list 首项与最终 transport.url，便于核对 wss_port 是否生效",
    "弹幕连接优先使用 getDanmuInfo 返回的 wss_port，缺失时再回退默认端口",
    "弹幕连接计划显式返回 User-Agent/Referer 请求头，连接握手责任收敛到插件侧",
    "getRoomDetail 添加 platform_cookie authMode 和 buvid Cookie，与 getPlayback 保持一致",
    "弹幕协议迁移到插件驱动：Bilibili WebSocket 鉴权、心跳与消息解析改为 plugin_js_v1"
  ],
  "shareResolve": {
    "hosts": [
      "b23.tv",
      "bili2233.cn",
      "bilibili.com"
    ]
  },
  "hostBehavior": {
    "externalRoomURLTemplate": "https://live.bilibili.com/{roomId}",
    "themeColor": "#FA7298"
  },
  "sessionMigration": {
    "userDefaultsCookieKeys": [
      "SimpleLive.Setting.BilibiliCookie"
    ],
    "userDefaultsUIDKeys": [
      "LiveParse.Bilibili.uid"
    ],
    "cleanupUserDefaultsKeys": [
      "SimpleLive.Setting.BilibiliCookie",
      "LiveParse.Bilibili.uid",
      "BilibiliCookieSyncService.sessionSnapshot",
      "BilibiliCookieSyncService.lastSyncedData"
    ],
    "legacyCloudRecordNames": [
      "bilibili_cookie_sync"
    ],
    "authCookieMarkers": [
      "SESSDATA"
    ],
    "legacyICloudSyncEnabledKeys": [
      "BilibiliCookieSyncService.iCloudSyncEnabled"
    ],
    "legacyICloudSyncTimeKeys": [
      "BilibiliCookieSyncService.lastICloudSyncTime"
    ]
  }
}
