{
  "pluginId": "cc",
  "version": "2.0.0",
  "apiVersion": 1,
  "displayName": "网易CC",
  "platformDescription": "网易 CC 直播平台",
  "liveTypes": [
    "4"
  ],
  "entry": "index.js",
  "preloadScripts": [
    "lp_plugin_cc_1.0.4_danmaku.js"
  ],
  "auth": {
    "required": false,
    "credentialKinds": [],
    "supportsStatusCheck": false,
    "supportsValidation": false
  },
  "capabilities": {
    "categories": {
      "status": "available"
    },
    "rooms": {
      "status": "available"
    },
    "playback": {
      "status": "available"
    },
    "search": {
      "status": "available"
    },
    "roomDetail": {
      "status": "available"
    },
    "liveState": {
      "status": "available"
    },
    "shareResolve": {
      "status": "available"
    },
    "danmaku": {
      "status": "available",
      "driver": "plugin_js_v1",
      "transport": "websocket_sockjs",
      "protocolId": "cc_sockjs_json",
      "protocolVersion": "1"
    }
  },
  "changelog": [
    "manifest 规范化：platformDescription 仅描述平台定位，登录需求改由 auth.required 与 credentialKinds 明确声明",
    "登录需求明确为不需要：该插件不声明账号凭据",
    "兼容 JSCore 缺失 URL 全局对象的运行环境，SockJS 地址改为纯字符串拼接生成",
    "弹幕连接地址改为插件侧显式生成 SockJS websocket 路径，避免直接连 /conn 导致升级失败",
    "继续沿用 Swift 版 CC SockJS 弹幕链路：open 帧后订阅 roomchat 并按原节奏发送心跳"
  ],
  "shareResolve": {
    "hosts": [
      "cc.163.com"
    ]
  },
  "hostBehavior": {
    "externalRoomURLTemplate": "https://cc.163.com/{roomId}",
    "themeColor": "#FBC02D"
  }
}
