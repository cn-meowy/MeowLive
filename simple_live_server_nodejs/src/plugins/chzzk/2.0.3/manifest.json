{
  "pluginId": "chzzk",
  "version": "2.0.3",
  "apiVersion": 1,
  "displayName": "CHZZK",
  "platformDescription": "CHZZK 韩国直播平台",
  "liveTypes": [
    "13"
  ],
  "entry": "index.js",
  "preloadScripts": [
    "danmaku.js"
  ],
  "auth": {
    "required": false,
    "credentialKinds": [],
    "supportsStatusCheck": false,
    "supportsValidation": false
  },
  "capabilities": {
    "categories": {
      "status": "available"
    },
    "rooms": {
      "status": "available"
    },
    "playback": {
      "status": "available"
    },
    "search": {
      "status": "available"
    },
    "roomDetail": {
      "status": "available"
    },
    "liveState": {
      "status": "available"
    },
    "shareResolve": {
      "status": "available"
    },
    "danmaku": {
      "status": "available",
      "driver": "plugin_js_v1",
      "transport": "websocket",
      "protocolId": "chzzk_chat_text",
      "protocolVersion": "1"
    }
  },
  "changelog": [
    "补齐宿主复制直播间链接：声明 hostBehavior.externalRoomURLTemplate，使用 CHZZK channelId 生成原站直播间外链",
    "补充宿主链接/口令解析候选规则：manifest 顶层声明 CHZZK shareResolve hosts/keywords",
    "manifest 规范化：platformDescription 仅描述平台定位，登录需求改由 auth.required 与 credentialKinds 明确声明",
    "登录需求明确为不需要：该插件不声明账号凭据",
    "2.0.1：播放清晰度从 master playlist 解析固定 variant，避免选择 1080p 后仍走自适应 master 降清晰度",
    "1.0.3：分类页 getRooms 固定按 50 条抓取，避免宿主 pageSize=20 时 talk 只看到 20 个房间",
    "1.0.3：保留 1.0.2 的单页请求策略，避免切换分类时后台请求风暴",
    "1.0.3：保留 1.0.1 的分类接口、图标、英文标题与 cursor 分页修复"
  ],
  "shareResolve": {
    "hosts": [
      "chzzk.naver.com"
    ],
    "keywords": [
      "chzzk"
    ]
  },
  "hostBehavior": {
    "externalRoomURLTemplate": "https://chzzk.naver.com/live/{roomId}"
  }
}
