{
  "pluginId": "mock",
  "version": "1.0.0",
  "apiVersion": 1,
  "displayName": "Mock Plugin",
  "platformDescription": "用于单元测试的 mock plugin",
  "entry": "index.js",
  "preloadScripts": ["preload.js"],
  "auth": {
    "required": true,
    "credentialKinds": ["cookie"],
    "supportsStatusCheck": true,
    "supportsValidation": true
  },
  "loginFlow": {
    "kind": "webview",
    "loginURL": "https://example.com/login",
    "cookieDomains": ["example.com"],
    "requiredCookieHint": "粘贴 example.com 登录后的 Cookie"
  },
  "capabilities": {
    "categories": { "status": "available" },
    "rooms": { "status": "available" },
    "playback": { "status": "available" },
    "search": { "status": "available" },
    "roomDetail": { "status": "available" },
    "liveState": { "status": "available" },
    "danmaku": {
      "status": "available",
      "driver": "plugin_js_v1",
      "transport": "websocket",
      "protocolId": "mock_ws",
      "protocolVersion": "1"
    }
  }
}